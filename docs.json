{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Framewurk CMS instructions",
  "description": "Step-by-step guides for every product—platform setup, analytics, and integrations in one place.",
  "colors": {
    "primary": "#5ba42b",
    "light": "#7bd93d",
    "dark": "#5ba42b"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Changelog",
          "icon": "scroll-text",
          "href": "https://www.mintlify.com/docs/changelog"
        },
        {
          "anchor": "Help",
          "icon": "life-buoy",
          "href": "https://www.mintlify.com/docs/contact-support"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Platform",
        "icon": "layers",
        "expanded": true,
        "pages": [
          "platform/quickstart",
          "platform/key-concepts",
          "platform/configuration/settings",
          "platform/configuration/user-management",
          "platform/administration/roles-permissions"
        ]
      },
      {
        "group": "Analytics",
        "icon": "chart-bar",
        "expanded": true,
        "pages": [
          "analytics/quickstart",
          "analytics/connect-data",
          "analytics/dashboards/create-dashboard",
          "analytics/reports/scheduled-reports"
        ]
      },
      {
        "group": "Integrations",
        "icon": "plug",
        "expanded": true,
        "pages": [
          "integrations/quickstart",
          "integrations/authentication",
          "integrations/connectors/crm",
          "integrations/webhooks/configure"
        ]
      },
      {
        "group": "Level 1",
        "pages": [
          {
            "group": "Level 2",
            "pages": [
              "hello-world/feature-experiments",
              {
                "group": "Level 3",
                "pages": [
                  "platform/virtual-campaigns"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/fw_icon.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  }
}

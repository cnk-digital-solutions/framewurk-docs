{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Framewurk CMS instructions",
  "description": "Step-by-step guides for every product—platform setup, analytics, and integrations in one place.",
  "colors": {
    "primary": "#5ba42b",
    "light": "#7bd93d",
    "dark": "#5ba42b"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "https://framewurk.mintlify.app/hello-world"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Level 1",
        "pages": [
          "hello-world",
          "hello-world/feature-experiments",
          {
            "group": "Level 2",
            "pages": [
              {
                "group": "Level 3",
                "pages": [
                  "platform/virtual-campaigns"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/fw_icon.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  }
}
